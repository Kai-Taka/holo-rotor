/*
 * holo-rotor pin map for an nRF52840 Pro Micro (nice!nano v2 / clones).
 * Pins are named the way they are silkscreened on most clones (P0.17 -> "017").
 *
 *   TMC2209     Pro Micro
 *   STEP   <--  P0.17   (hardware PWM1, jitter-free step pulses)
 *   DIR    <--  P0.20
 *   EN     <--  P0.22   (TMC2209 EN is active-low: low = driver on)
 *   VIO    <--  VCC     (3.3 V, switched by P0.13 on nice!nano-style boards)
 *   GND    ---  GND
 *   MS1/MS2     tie to GND/VCC to pick microsteps (see README)
 *
 * Reserved for a later TMC2209 UART link (PDN_UART): P0.06 (TX), P0.08 (RX).
 */

&pinctrl {
	pwm1_default: pwm1_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 17)>;
		};
	};

	pwm1_sleep: pwm1_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 17)>;
			low-power-enable;
		};
	};
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	zephyr,user {
		pwms = <&pwm1 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
		pwm-names = "step";
		dir-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		en-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
		/* Turns on the switched VCC pin on nice!nano-style boards (harmless elsewhere). */
		vcc-en-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
	};
};
